APP_NAME=Hades
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Bratislava

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=hades
DB_USERNAME=hades
DB_PASSWORD=hades

SESSION_DRIVER=file
# 30 dní: session drží odomknutie UI okruhu (HADES_UI_TOKEN nižšie), takže
# pôvodných 120 minút by znamenalo zamknutý dashboard po dvoch hodinách nečinnosti
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hades@localhost"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=733407
REVERB_APP_KEY=r4cu0kxoi1bbwgbqxizc
REVERB_APP_SECRET=cbhjkeiadbvn8hykawrq
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

HADES_PUBLIC_WS_HOST=localhost
HADES_PUBLIC_WS_PORT=8081

ANTHROPIC_API_KEY=
HADES_CHAT_MODEL=claude-opus-4-8

# Brain-indexer režim (Apollo integrácia)
# Bearer token pre externé /api/v1/* (prázdny = fail-closed 401, nikto neprejde)
HADES_API_TOKEN=
# Povoliť zápis do ľudsky písaných .md „mozgov" (default OFF, fail-safe)
HADES_ALLOW_BRAIN_WRITE=false
# Externé .md cesty na indexovanie (';' oddelené), napr. /brain;/notes
HADES_BRAIN_PATHS=

# Token pre /mcp. JEDEN zdroj pre dve cesty: Laravel ho overuje ako
# `Authorization: Bearer` aj `?token=` (config/hades.php → AuthenticateMcp)
# a Caddy ho vkladá do query matchera na verejnom porte 8095 (docker/Caddyfile).
# Prázdny = fail-closed (401 pre všetkých) + caddy sa nespustí.
# Generuj náhodný, len znaky [A-Za-z0-9_-] (iné by rozbili Caddyfile), napr.:
#   php -r "echo rtrim(strtr(base64_encode(random_bytes(24)), '+/', '-_'), '=');"
HADES_MCP_TOKEN=

# Token pre UI okruh — dashboard `/` aj interné /api/*, ktoré volá SPA
# (config/hades.php → AuthenticateUi). JEDEN zdroj pre dve cesty: Laravel ho
# overuje ako `?token=` alebo hlavičku `X-Hades-Ui-Token`, a Caddy ho na verejnom
# porte 8095 vkladá do hlavičky za basic-auth, takže tunel netreba odomykať zvlášť.
# Prázdny = fail-closed (401 pre všetkých vrátane dashboardu) + caddy sa nespustí.
# Odomknutie v prehliadači raz cez http://localhost:8080/?token=<hodnota>, ďalej
# to drží session cookie (SESSION_LIFETIME vyššie). Rotácia = zmeniť tu, spustiť
# `docker compose up -d caddy`; všetky staré odomknuté session tým padnú.
# Generuj náhodný, napr.:
#   php -r "echo bin2hex(random_bytes(32));"
HADES_UI_TOKEN=

# Bcrypt hash hesla na verejný (ngrok) prístup cez Caddy, meno používateľa: hades.
# Hashuj heslo, nie meno:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TVOJE-HESLO'
# MUSÍ byť v jednoduchých úvodzovkách — bez nich compose zožerie `$…` časti
# hashu a Caddy dostane zrezanú hodnotu (každé heslo → 401). Teda takto:
#   CADDY_BASIC_AUTH_HASH='$2y$12$…'
CADDY_BASIC_AUTH_HASH=
