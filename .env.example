APP_NAME=AuraAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_TIMEZONE=Europe/Bratislava

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=auraai
DB_USERNAME=auraai
DB_PASSWORD=auraai

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="auraai@localhost"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

AURAAI_PUBLIC_WS_HOST=localhost
AURAAI_PUBLIC_WS_PORT=8083

# --- Jazykové modely -------------------------------------------------------
# Lokálny LLM cez Ollama je PRIMÁRNY a jediný povinný. Appka musí fungovať aj
# keď Ollama vôbec nebeží — utility úlohy majú deterministický fallback.
OLLAMA_URL=http://ollama:11434
# Router / vyhodnocovač zámeru a výber šablóny odpovede (malý, rýchly)
AURAAI_ROUTER_MODEL=qwen3:0.6b
# Embeddingy pre recall (nahrádza ručný SK<->EN slovník v SimilarityService)
AURAAI_EMBED_MODEL=multilingual-e5-small
# Eskalácia, keď šablónová odpoveď nestačí (voliteľné, väčší ale stále free model)
AURAAI_ESCALATION_MODEL=nemotron-mini

# Voliteľné a VYPNUTÉ: platené Anthropic API. Bez kľúča sa provider neregistruje
# a chat beží plne lokálne. Doplň kľúč len ak chceš mať možnosť si ho vyžiadať.
ANTHROPIC_API_KEY=
AURAAI_CHAT_MODEL=claude-opus-4-8

# --- Guardy ----------------------------------------------------------------
# Bearer token pre externé /api/v1/* (prázdny = fail-closed 401, nikto neprejde)
AURAAI_API_TOKEN=
# Povoliť zápis do ľudsky písaných .md „mozgov" (default OFF, fail-safe)
AURAAI_ALLOW_BRAIN_WRITE=false
# Externé .md cesty na indexovanie (';' oddelené), napr. /brain;/notes
AURAAI_BRAIN_PATHS=
# DEŠTRUKTÍVNE nočné joby (cleanup-edges, prune-coactivation, automerge).
# Nevratne mažú hrany a zlučujú uzly. Prahy sú kalibrované na TF-IDF, takže po
# prechode na embeddingy musia zostať VYPNUTÉ do rekalibrácie a schváleného
# --dry-run reportu. Default OFF (fail-safe).
AURAAI_DESTRUCTIVE_JOBS=false

# --- Reverzný proxy (ngrok) ------------------------------------------------
# Tajný token pre /mcp v query stringu (appka Claude nevie poslať Basic Auth).
# Prázdny = matcher sa nezhodne a /mcp spadne do basic-auth (fail-closed).
# NIKDY nezapisovať priamo do docker/Caddyfile — ten je trackovaný v gite.
MCP_QUERY_TOKEN=

# --- Sperky e-shop API (orders:read + verejne products) -----------------
# Kluc NIKDY necommitovat; zije len v .env. Dokumentacia: docs/sperky-api.md
SPERKY_API_URL=https://sperky-eshop.sk
SPERKY_API_KEY=
