# Caddy reverzný proxy pre verejný (ngrok) prístup k AuraAI.
# Zlúči appku (8080) aj Reverb WebSocket (8081) na JEDEN port (8095 v kontajneri,
# 8084 na hostiteľovi), takže jeden ngrok tunel prenesie aj HTTP aj živé pulzy.
# Chránené basic-auth. Lokálny priamy prístup na appku toto NEobchádza a nemá heslo.
{
	admin off
	auto_https off

	# Bez tohto Caddy PREPÍŠE `X-Forwarded-Proto: https` od cloudflared na `http`,
	# lebo tunel sa naň pripája plain HTTP na :8095 — a hlavičkám od netrustnutého
	# klienta neverí. Laravel potom vidí http, vygeneruje `http://` odkazy na
	# assety na https stránke a prehliadač zablokuje celý Vite bundle ako mixed
	# content: appka sa vonku otvorí ako neštýlované HTML s názvami ikon namiesto
	# ikon. Trust je zúžený na privátne rozsahy, teda na Docker sieť, kde je jediný
	# možný odosielateľ tunelový kontajner; appka sama je len na 127.0.0.1.
	#
	# POZOR: `trustProxies` na strane Laravelu toto NEVYRIEŠI. Tam sa rozhoduje,
	# či hlavičke veriť, ale hlavička už musí dôjsť správna — a prepisuje ju Caddy.
	# Overenie musí ísť cez celú cestu (curl na verejnú URL), nie na `app:8080`.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Jedno miesto s prihlasovacími údajmi. Predtým bol ten istý blok (aj ten istý
# bcrypt hash) opísaný dvakrát — pri rotácii hesla sa dala jedna kópia prehliadnuť
# a tichým spôsobom nechať otvorenú.
#
# Používateľ je `aura` (rozhodnutie #25; predtým `hades`) — uložené prihlásenie
# v prehliadači treba prepísať. HESLO SA NEMENÍ, bcrypt hash sa hashuje len z
# hesla, nie z používateľského mena.
#
# Hash je v `.env` ako CADDY_BASIC_AUTH_HASH (gitignored). Predtým sedel priamo
# tu, v git-trackovanom súbore, takže starý hash žije v histórii repa a treba ho
# považovať za oslabený — bcrypt sa dá lámať offline a toto heslo je jediná brána
# medzi internetom a dlhodobou pamäťou. Heslo bolo preto 4. 8. 2026 rotované.
#
# Fail-closed: ak premenná nie je nastavená, Caddy odmietne štartovať s prázdnym
# hashom (chyba pri parsovaní), namiesto toho aby tunel nechal otvorený.
(aura_auth) {
	basic_auth {
		aura {$CADDY_BASIC_AUTH_HASH}
	}
}

:8095 {
	# MCP prístup pre appku Claude: konektory tam vedia poslať len URL, žiadnu
	# Basic Auth hlavičku — preto tajný token v query stringu namiesto hesla.
	#
	# Toto UŽ NIE JE bezpečnostný bypass. Do W2 bol `/mcp` na strane appky úplne
	# bez autentifikácie, takže tento matcher robil z verejného tunela otvorený
	# ZÁPISOVÝ endpoint do dlhodobej pamäte (`aura_learn`, `aura_decision`).
	# Odteraz `/mcp` autentifikuje middleware `auth.mcp` (Bearer alebo `?token=`)
	# a má throttle — Caddy tu už len smeruje, gate je appka. Rozhodnutie #21.
	#
	# Token je v .env ako MCP_QUERY_TOKEN a compose ho podáva tomuto kontajneru;
	# tú istú hodnotu čítá `config/mcp.php`, takže rotácia je jeden riadok.
	# Predtým bol zapísaný priamo tu, plaintextom, v git-trackovanom súbore —
	# takže žije v histórii repozitára a MUSÍ byť rotovaný.
	# Zmena tokenu = upraviť .env + `docker compose up -d caddy`.
	#
	# Fail-closed: ak MCP_QUERY_TOKEN nie je nastavený, tento matcher sa nezhodne
	# so žiadnou požiadavkou a /mcp spadne do basic-auth bloku nižšie.
	@mcp_token {
		path /mcp
		query token={$MCP_QUERY_TOKEN}
	}
	handle @mcp_token {
		reverse_proxy app:8080
	}

	# OAuth discovery sondy appky Claude musia dostať 404 (nie 401 z basic_auth),
	# inak si appka myslí, že server má OAuth prihlásenie, a pripojenie zlyhá.
	# Z toho istého dôvodu `auth.mcp` neposiela `WWW-Authenticate`.
	@oauth_probe path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /register
	handle @oauth_probe {
		respond 404
	}

	# WebSocket (pusher protokol Reverbu beží na ceste /app/<key>) → Reverb
	@ws path /app /app/*
	handle @ws {
		import aura_auth
		reverse_proxy reverb:8081
	}

	# Všetko ostatné (dashboard, chat, priamy /mcp bez tokenu) → basic-auth.
	handle {
		import aura_auth
		reverse_proxy app:8080
	}
}
